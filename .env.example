# Copie para .env (local) ou configure no Vercel (produção).
# Nunca commite valores reais.

# --- Obrigatórias ---
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"
AUTH_SECRET="gere-uma-string-aleatoria-com-32-caracteres-ou-mais"

# Chaves de criptografia (mínimo 32 caracteres; diferentes entre si)
ENCRYPTION_KEY="gere-uma-chave-aleatoria-com-32-caracteres-ou-mais"
ENCRYPTION_HMAC_KEY="gere-outra-chave-aleatoria-com-32-caracteres-ou-mais"

# --- URLs públicas ---
# URL base do app (usada no layout e em links públicos). No Vercel, use o domínio real.
NEXT_PUBLIC_APP_URL="https://seu-dominio.vercel.app"
# URL base dos links de recuperação de senha por e-mail. O primeiro acesso é entregue por link de convite na tela de colaboradores.
PUBLIC_APP_URL="https://seu-dominio.vercel.app"

# --- Billing (Asaas) — integração adiada; não habilitar até nova validação ---
ASAAS_API_KEY=""
ASAAS_ENVIRONMENT="sandbox"
ASAAS_WEBHOOK_TOKEN=""

# --- Cron (Vercel) ---
# Segredo enviado pelo Vercel no header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# --- E-mail ---
# smtp | console | none (padrão: console em dev, none em produção)
# Em produção, configure SMTP_HOST, SMTP_USER, SMTP_PASSWORD e SMTP_FROM para recuperação de senha.
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="nao-responda@teamflow.local"
